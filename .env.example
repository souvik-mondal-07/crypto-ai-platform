# This is the root-level example. Frontend and backend each also have
# their own .env.example inside their respective directories — copy
# those into frontend/.env and backend/.env for local development.

# --- Frontend (frontend/.env.example) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Backend (backend/.env.example) ---
APP_NAME=Crypto AI Platform
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# MongoDB (Step 2) — embed credentials in the URI itself if needed,
# never as separate fields. Never commit a real URI with credentials.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=crypto_ai_platform

# Market data providers (Step 3) — official public APIs, no scraping.
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
BINANCE_API_BASE_URL=https://api.binance.com
COINGECKO_API_KEY=
ENABLE_DEV_SYNC_ENDPOINT=false

# Authentication (Step 4) — generate a real random secret for any
# non-local environment; never commit an actual secret.
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# No API keys are required through Step 4 (COINGECKO_API_KEY is
# optional). Future steps will introduce Redis and other third-party
# API keys (news, Gemini, etc.) with their own documented environment
# variables at that time.

# ML prediction engine (Phase 13)
# Where trained model artifacts live (relative paths = relative to the repo root).
# This directory is git-ignored; models are produced by
#   python -m ml.pipelines.training_pipeline ...
ML_ARTIFACT_DIR=ml/artifacts
ML_DEFAULT_HORIZON=24h
# xgboost | lightgbm | lstm | ridge | ensemble
ML_DEFAULT_MODEL=xgboost
# Minimum real candles needed to train a model for a coin/horizon.
ML_MIN_HISTORY_LENGTH=500
# How long a stored prediction is reused before being regenerated.
ML_PREDICTION_TTL_SECONDS=900

# --- Risk & Decision engine (Phase 14) ---
# Weights/thresholds are in backend/app/config/risk_config.py (versioned, not env-driven).
# Seconds the decision waits for the Phase 13 prediction before using the latest stored one.
DECISION_PREDICTION_TIMEOUT_SECONDS=8

# Phase 15 - Gemini AI Analysis
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_SECONDS=1.5
AI_ANALYSIS_TTL_SECONDS=1800
AI_ANALYSIS_MIN_REGENERATE_INTERVAL_SECONDS=60
AI_ANALYSIS_MAX_CONCURRENT_GENERATIONS=2
