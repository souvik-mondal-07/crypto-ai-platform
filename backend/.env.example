APP_NAME=Crypto AI Platform
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# MongoDB (Step 2)
# If your MongoDB requires authentication, embed credentials in the
# URI itself, e.g.:
#   mongodb://<username>:<password>@localhost:27017
# Never commit a real URI containing credentials — this file must
# only ever contain placeholders.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=crypto_ai_platform

# Market data providers (Step 3)
# Both base URLs are official public API endpoints — no scraping.
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
BINANCE_API_BASE_URL=https://api.binance.com

# Optional. CoinGecko's public endpoints used by this app do not
# require a key. Setting one (free "Demo" tier) raises your own rate
# limit; leave blank to use the unauthenticated public rate limit.
COINGECKO_API_KEY=

# Development-only market sync trigger (see app/api/v1/dev_sync.py).
# Off by default. This is NOT authentication — do not set this to
# true in any publicly reachable deployment.
ENABLE_DEV_SYNC_ENDPOINT=false

# Real-time market-data background refresh (part of the real-time refresh upgrade).
# See app/services/market_refresh_scheduler.py for what each of these
# actually controls.
MARKET_REFRESH_ENABLED=true
MARKET_REFRESH_INTERVAL_SECONDS=60
MARKET_REFRESH_MAX_PAGES=8
MARKET_REFRESH_HOT_PAGES=2
MARKET_REFRESH_PER_PAGE=250
MARKET_REFRESH_REQUEST_DELAY_SECONDS=1.5
MARKET_REFRESH_INCLUDE_BINANCE=true
MARKET_REFRESH_UNIVERSE_INTERVAL_SECONDS=21600

# Authentication (Step 4)
# CRITICAL: generate a real random secret for any non-local
# environment, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
# This placeholder is intentionally obvious so it's never mistaken for
# a real secret. Never commit an actual secret here or anywhere else.
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fundamental analysis (Phase 11)
# Provider project/ecosystem data is reused this long before re-fetching.
FUNDAMENTALS_PROFILE_TTL_SECONDS=21600
# Minimum seconds between provider fetches per coin, even with force_refresh.
FUNDAMENTALS_MIN_REFRESH_INTERVAL_SECONDS=60

# News & sentiment (Phase 12)
# CryptoCompare / CoinDesk Data news API. The key is optional but raises
# the rate limit; keep it server-side only (never in the frontend).
CRYPTOCOMPARE_API_KEY=
NEWS_REFRESH_ENABLED=true
NEWS_REFRESH_INTERVAL_SECONDS=600
SENTIMENT_ENABLED=true
SENTIMENT_MODEL_NAME=ProsusAI/finbert

# ML prediction engine (Phase 13)
# Where trained model artifacts live (relative paths = relative to the repo root).
# This directory is git-ignored; models are produced by
#   python -m ml.pipelines.training_pipeline ...
ML_ARTIFACT_DIR=ml/artifacts
ML_DEFAULT_HORIZON=24h
# xgboost | lightgbm | lstm | ridge | ensemble
ML_DEFAULT_MODEL=xgboost
# Minimum real candles needed to train a model for a coin/horizon.
ML_MIN_HISTORY_LENGTH=500
# How long a stored prediction is reused before being regenerated.
ML_PREDICTION_TTL_SECONDS=900

# --- Risk & Decision engine (Phase 14) ---
# Weights/thresholds are in backend/app/config/risk_config.py (versioned, not env-driven).
# Seconds the decision waits for the Phase 13 prediction before using the latest stored one.
DECISION_PREDICTION_TIMEOUT_SECONDS=8

# --- Gemini AI analysis (Phase 15) ---
# Server-side only. Never put this key in the frontend (no VITE_ variable) and never commit a real key.
# Without a key the app works normally; only the AI Analysis section reports "temporarily unavailable".
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_SECONDS=1.5
AI_ANALYSIS_TTL_SECONDS=1800
AI_ANALYSIS_MIN_REGENERATE_INTERVAL_SECONDS=60
AI_ANALYSIS_MAX_CONCURRENT_GENERATIONS=2
